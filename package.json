    "fences.js",
    "front-matter.js",
    "sessions.js",
    "chapter.js",
    "session-run.js",
    "events.js",
    "bin/",
    "languages/",
    "runners/"
  ],
  "scripts": {
    "test": "node test/run-all.js",
    "test:quick": "node test/run-all.js --quick",
    "test:mrjob": "node sample/mrjob/test.js"
  },
  "engines": {
    "node": ">=16.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quqingyuan/mdcode2run.git"
